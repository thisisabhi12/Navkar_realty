# ====================================================================
# NAVKAR REALTY - EMAIL NOTIFICATION CONFIGURATION
# ====================================================================

# Notification Destination (Where all website leads and inquiries are delivered)
NOTIFICATION_RECIPIENT=realtynavkar61@gmail.com

# Notification Sender Name / Address
NOTIFICATION_SENDER="Navkar Realty Desk" <realtynavkar61@gmail.com>

# --------------------------------------------------------------------
# SMTP Server Credentials (Google Workspace / Gmail or Any SMTP Provider)
# --------------------------------------------------------------------
# For Gmail / Google Workspace:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address in SMTP_USER and the 16-character code in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=realtynavkar61@gmail.com
SMTP_PASS=your-16-character-app-password

# --------------------------------------------------------------------
# Alternative: Custom SMTP (e.g. SendGrid, Brevo, AWS SES, Hostinger)
# --------------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-key

# Production Server Port
PORT=3000

